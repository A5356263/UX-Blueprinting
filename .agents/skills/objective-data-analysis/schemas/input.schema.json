{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "objective-data-analysis.input.schema.json",
  "title": "Objective Data Analysis Request 4.0.0",
  "type": "object",
  "required": ["artifact_type", "artifact_version", "project_name", "source_mode", "invocation_context", "analysis_purpose", "requested_analyses", "input_bindings", "requested_deliverables", "publication_policy", "retention_policy", "input_data_sources"],
  "properties": {
    "artifact_type": {"const": "objective_analysis_request"},
    "artifact_version": {"const": "4.0.0"},
    "project_name": {"type": "string", "minLength": 1},
    "source_mode": {"enum": ["independent", "chain_context"]},
    "invocation_context": {"enum": ["independent", "chain_context"]},
    "analysis_purpose": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/analysis_purpose"},
    "input_bindings": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/input_bindings"},
    "requested_deliverables": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/requested_deliverables"},
    "publication_policy": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/publication_policy"},
    "retention_policy": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/retention_policy"},
    "analysis_intent": {"enum": ["comprehensive", "report", "focused"], "default": "comprehensive"},
    "analysis_question": {"type": "string"},
    "analysis_scope": {"type": "object"},
    "upstream_context_refs": {"type": "array", "items": {"type": "object"}},
    "upstream_analysis_contract": {"type": "object"},
    "business_rule_sources": {"type": "array", "items": {"$ref": "#/$defs/ruleSource"}},
    "input_data_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "requested_analyses": {"type": "array", "uniqueItems": true, "items": {"enum": ["metrics", "funnel", "journey", "errors", "segments", "baseline", "feature_usage", "enterprise_states"]}},
    "analysis_contract": {"$ref": "#/$defs/analysisContract"},
    "metric_definitions": {"type": "array", "items": {"type": "object"}},
    "business_thresholds": {"type": "array", "items": {"type": "object"}}
  },
  "allOf": [{
    "if": {"properties": {"source_mode": {"const": "independent"}}, "required": ["source_mode"]},
    "then": {
      "properties": {
        "upstream_context_refs": {"maxItems": 0},
        "upstream_analysis_contract": {"maxProperties": 0}
      }
    }
  }],
  "$defs": {
    "source": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "source_id": {"type": "string"},
        "path": {"type": "string", "minLength": 1},
        "format": {"enum": ["csv", "tsv", "xlsx", "json", "jsonl"]},
        "role": {"type": "string"},
        "semantic_type": {"enum": ["aggregate_metric_summary", "task_summary", "journey_node_detail", "error_context_detail", "business_blueprint", "dimension_lookup", "enterprise_state_detail", "general_event_log"]},
        "metric_authority": {"enum": ["official", "reference", "diagnostic"], "default": "diagnostic"},
        "enterprise_state_type": {"enum": ["active", "deep_active", "retained"]},
        "blueprint_authority": {"enum": ["formal", "user_confirmed", "business_confirmed", "reference_only"]},
        "scope": {
          "type": "object",
          "properties": {
            "time_window": {"type": "string"},
            "grain": {"type": "string"},
            "population": {"type": "string"},
            "scope_fingerprint": {"type": "string"}
          },
          "additionalProperties": true
        },
        "sheets": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
        "critical": {"type": "boolean", "default": false},
        "data_grain": {"enum": ["event", "task_summary"]},
        "field_mapping": {"type": "object", "additionalProperties": {"type": "string"}},
        "field_fallbacks": {
          "type": "object",
          "additionalProperties": {
            "type": "array", "minItems": 1, "items": {"type": "string"}
          }
        },
        "event_classification_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event_class", "conditions"],
            "properties": {
              "event_class": {"enum": ["entry_event", "step_event", "submit_event", "success_event", "exit_event", "draft_event", "backtrack_event", "help_event", "error_event", "noise_event"]},
              "conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "ruleSource": {
      "type": "object",
      "properties": {
        "source": {"enum": ["user_confirmed", "uxb", "business_config", "upstream_requirement", "analyst_proposed"]},
        "ref": {"type": "string"},
        "confirmation_status": {"enum": ["confirmed", "analyst_proposed_user_accepted", "analyst_proposed_pending_confirmation"]}
      },
      "additionalProperties": true
    },
    "condition": {
      "type": "object",
      "required": ["field", "op"],
      "properties": {
        "field": {"type": "string"}, "op": {"enum": ["eq", "in", "not_empty", "contains"]},
        "value": {}, "values": {"type": "array"}
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "required": ["segment_id", "conditions", "basis"],
      "properties": {
        "segment_id": {"type": "string"}, "label": {"type": "string"},
        "conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}},
        "task_field_resolution": {"enum": ["require_consistent", "first_non_empty", "last_non_empty"]},
        "basis": {
          "type": "object", "required": ["source"],
          "properties": {"source": {"enum": ["user_confirmed", "uxb", "business_config", "upstream_requirement"]}, "ref": {"type": "string"}},
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "featureAnalysis": {
      "type": "object",
      "properties": {
        "subject_col": {"type": "string"}, "event_col": {"type": "string"},
        "entry_event": {"type": "string"}, "exposure_event": {"type": "string"},
        "usage_event": {"type": "string"}, "completion_event": {"type": "string"},
        "eligibility": {
          "type": "object",
          "properties": {
            "event": {"type": "string"},
            "subject_ids": {"type": "array", "items": {"type": ["string", "number"]}},
            "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "baselineAnalysis": {
      "type": "object",
      "properties": {
        "period_col": {"type": "string"}, "metric_col": {"type": "string"},
        "numerator_col": {"type": "string"}, "denominator_col": {"type": "string"},
        "period_aggregation": {"enum": ["sum", "mean", "median", "latest"]}, "order_col": {"type": "string"},
        "task_identity": {"type": "string"}, "task_name": {"type": "string"}, "require_task_identity": {"type": "boolean"},
        "current_periods": {"type": "integer", "minimum": 1}, "minimum_history": {"type": "integer", "minimum": 1},
        "rolling_window": {"type": "integer", "minimum": 1}, "method": {"enum": ["median_quantile", "mean_sd", "same_period"]},
        "season_col": {"type": "string"}, "metric_contract_id": {"type": "string"}, "grain": {"type": "string"},
        "scenario_key": {"type": "string"}, "definition_version": {"type": ["string", "number"]},
        "baseline_ref": {
          "type": "object", "required": ["baseline_id", "baseline_version"],
          "properties": {"baseline_id": {"type": "string"}, "baseline_version": {"type": ["string", "integer"]}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "analysisContract": {
      "type": "object",
      "properties": {
        "field_mapping": {"type": "object", "additionalProperties": {"type": "string"}},
        "journey_path_delimiter": {"type": "string", "minLength": 1},
        "task_duration_unit": {"enum": ["milliseconds", "seconds", "minutes", "hours", "ms", "s", "min", "h", "毫秒", "秒", "分钟", "小时"]},
        "event_mapping": {"type": "object"}, "funnel_steps": {"type": "array", "items": {"type": "string"}},
        "completion_events": {"type": "array", "items": {"type": "string"}}, "submit_events": {"type": "array", "items": {"type": "string"}},
        "draft_events": {"type": "array", "items": {"type": "string"}}, "exit_events": {"type": "array", "items": {"type": "string"}},
        "restart_events": {"type": "array", "items": {"type": "string"}}, "task_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "expected_steps": {"type": "array", "items": {"type": "string"}}, "exclusion_rules": {"type": "array", "items": {"type": "object"}},
        "journey_blueprints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["blueprint_id", "required_steps", "basis"],
            "properties": {
              "blueprint_id": {"type": "string"},
              "label": {"type": "string"},
              "applicability_conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
              "required_steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "optional_steps": {"type": "array", "items": {"type": "string"}},
              "alternative_step_groups": {"type": "array", "items": {"type": "array", "minItems": 2, "items": {"type": "string"}}},
              "allowed_terminals": {"type": "array", "items": {"type": "string"}},
              "basis": {"$ref": "#/$defs/ruleSource"}
            },
            "additionalProperties": false
          }
        },
        "metric_conflict_tolerance": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.0001},
        "dimension_joins": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["lookup_source_id", "value_fields"],
            "properties": {
              "lookup_source_id": {"type": "string"},
              "target_key": {"type": "string", "default": "enterprise_id"},
              "lookup_key": {"type": "string", "default": "enterprise_id"},
              "value_fields": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
              "minimum_coverage": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "additionalProperties": false
          }
        },
        "cross_source_deduplication": {
          "type": "object", "required": ["enabled", "event_key_fields"],
          "properties": {"enabled": {"const": true}, "event_key_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
          "additionalProperties": false
        },
        "segment_definitions": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
        "minimum_segment_sample": {"type": "integer", "minimum": 1},
        "feature_analysis": {"$ref": "#/$defs/featureAnalysis"},
        "baseline_analysis": {"$ref": "#/$defs/baselineAnalysis"},
        "enterprise_state_analysis": {
          "type": "object",
          "properties": {
            "transition_rules": {"type": "array", "items": {"type": "object"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
