{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-proto.local/schemas/release-report-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "version", "coreVersion", "coreDigest", "layoutVersion", "commonInstructionDigest", "runtimeLockDigest", "distributions"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "ux-proto-release-report" },
    "version": { "const": "1.3.2" },
    "coreVersion": { "const": "1.3.2" },
    "coreDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "layoutVersion": { "const": "1.0" },
    "commonInstructionDigest": { "type": "string" },
    "runtimeLockDigest": { "type": "string" },
    "distributions": {
      "type": "object",
      "required": ["ux-proto", "ux-proto-g", "ux-proto-assets-builder"],
      "additionalProperties": false,
      "properties": {
        "ux-proto": { "type": "object" },
        "ux-proto-g": { "type": "object" },
        "ux-proto-assets-builder": { "type": "object" }
      }
    }
  }
}
