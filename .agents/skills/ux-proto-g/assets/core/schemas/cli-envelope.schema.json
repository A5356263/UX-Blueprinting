{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-proto.local/schemas/cli-envelope-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "status"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "command": { "type": "string" },
    "status": { "enum": ["success", "partial", "failed"] },
    "data": {},
    "failures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["category", "message"],
        "properties": {
          "category": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "message", "context"],
      "properties": { "category": { "type": "string" }, "message": { "type": "string" }, "context": { "type": "object" } }
    }
  },
  "oneOf": [
    { "properties": { "status": { "const": "success" } }, "required": ["data"], "not": { "anyOf": [{ "required": ["error"] }, { "required": ["failures"] }] } },
    { "properties": { "status": { "const": "partial" } }, "required": ["data", "failures"], "not": { "required": ["error"] } },
    { "properties": { "status": { "const": "failed" } }, "required": ["error"], "not": { "required": ["data"] } }
  ]
}
