{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-proto.local/schemas/materialization-v2.json",
  "title": "UX Proto materialize CLI v2 data contract",
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/successEnvelope" }, { "$ref": "#/$defs/failureEnvelope" }],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "decisionMap": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "selection": { "type": "object", "additionalProperties": false, "required": ["fingerprint", "decisions"], "properties": { "fingerprint": { "$ref": "#/$defs/nonEmptyString" }, "decisions": { "$ref": "#/$defs/decisionMap" } } },
    "request": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "assetId", "selection", "reselect"], "properties": { "schemaVersion": { "const": 2 }, "assetId": { "$ref": "#/$defs/nonEmptyString" }, "selection": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/selection" }] }, "reselect": { "type": "boolean" } } },
    "configuration": { "type": "object", "additionalProperties": false, "required": ["fingerprint", "blocks", "constraints", "presets", "nonConfigurableBoundary"], "properties": { "fingerprint": { "$ref": "#/$defs/nonEmptyString" }, "blocks": { "type": "array" }, "constraints": { "type": "array" }, "presets": { "type": "array" }, "nonConfigurableBoundary": { "$ref": "#/$defs/nonEmptyString" } } },
    "nextAction": { "type": "object", "additionalProperties": false, "required": ["kind", "assetId"], "properties": { "kind": { "const": "materialize-submit-selection" }, "assetId": { "$ref": "#/$defs/nonEmptyString" } } },
    "import": { "type": "object", "additionalProperties": false, "required": ["exportName", "importPath", "statement"], "properties": { "exportName": { "$ref": "#/$defs/nonEmptyString" }, "importPath": { "$ref": "#/$defs/nonEmptyString" }, "statement": { "$ref": "#/$defs/nonEmptyString" } } },
    "menuResult": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "status", "assetId", "wrote", "readyToAuthor", "configuration", "nextActions", "target", "proof"], "properties": { "schemaVersion": { "const": 2 }, "status": { "enum": ["configuration-required", "reselect-configuration-required"] }, "assetId": { "$ref": "#/$defs/nonEmptyString" }, "wrote": { "const": false }, "readyToAuthor": { "const": false }, "configuration": { "$ref": "#/$defs/configuration" }, "nextActions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nextAction" } }, "target": { "$ref": "#/$defs/nonEmptyString" }, "proof": { "type": "null" } } },
    "baseWriteResult": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "status", "assetId", "written", "provenanceFiles", "imports", "editPolicy", "customizationSurfaces", "wrote", "readyToAuthor", "target", "proof"], "properties": { "schemaVersion": { "const": 2 }, "status": { "type": "string" }, "assetId": { "$ref": "#/$defs/nonEmptyString" }, "written": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }, "provenanceFiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }, "imports": { "type": "array", "items": { "$ref": "#/$defs/import" } }, "editPolicy": { "const": "page-owned" }, "customizationSurfaces": { "type": "array" }, "wrote": { "type": "boolean" }, "readyToAuthor": { "type": "boolean" }, "target": { "$ref": "#/$defs/nonEmptyString" }, "proof": { "$ref": "#/$defs/nonEmptyString" }, "recoveryPath": { "$ref": "#/$defs/nonEmptyString" } } },
    "materializedResult": { "allOf": [{ "$ref": "#/$defs/baseWriteResult" }, { "properties": { "status": { "const": "materialized" }, "wrote": { "const": true }, "readyToAuthor": { "const": true } } }] },
    "reselectedResult": { "allOf": [{ "$ref": "#/$defs/baseWriteResult" }, { "required": ["recoveryPath"], "properties": { "status": { "const": "reselected" }, "wrote": { "const": true }, "readyToAuthor": { "const": true }, "recoveryPath": { "$ref": "#/$defs/nonEmptyString" } } }] },
    "alreadyMaterializedResult": { "allOf": [{ "$ref": "#/$defs/baseWriteResult" }, { "properties": { "status": { "const": "already-materialized" }, "wrote": { "const": false }, "readyToAuthor": { "const": true } } }] },
    "result": { "oneOf": [{ "$ref": "#/$defs/menuResult" }, { "$ref": "#/$defs/materializedResult" }, { "$ref": "#/$defs/reselectedResult" }, { "$ref": "#/$defs/alreadyMaterializedResult" }] },
    "error": { "type": "object", "additionalProperties": false, "required": ["category", "message", "context"], "properties": { "category": { "$ref": "#/$defs/nonEmptyString" }, "message": { "$ref": "#/$defs/nonEmptyString" }, "context": { "type": "object" } } },
    "successEnvelope": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "command", "status", "data"], "properties": { "schemaVersion": { "const": 2 }, "command": { "const": "materialize" }, "status": { "const": "success" }, "data": { "$ref": "#/$defs/result" } } },
    "failureEnvelope": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "command", "status", "error"], "properties": { "schemaVersion": { "const": 2 }, "command": { "const": "materialize" }, "status": { "const": "failed" }, "error": { "$ref": "#/$defs/error" } } }
  }
}
