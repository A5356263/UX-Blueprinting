{
  "id": "pattern.xft-page-template-selection",
  "kind": "Pattern",
  "title": "xft 模板选用指南",
  "abstract": "依据需求中明确的使用条件选用 XFT 模板，不从模板反推页面应包含的模块。",
  "content": {
    "模板选用": [
      {
        "标题": "XFT 应用框架",
        "选用规则": [
          "所有 XFT 工作区页面都使用应用框架。工作区内打开的弹窗、抽屉和局部模块沿用所在页面的框架。"
        ],
        "模板": {
          "assetLink": "template.application-frame",
          "load": "full"
        }
      },
      {
        "标题": "XFT 设置页",
        "选用规则": [
          "需求明确有至少两个具名设置组，且各设置项修改后即时生效时使用。"
        ],
        "模板": {
          "assetLink": "template.settings-page"
        }
      },
      {
        "标题": "XFT 审批同意弹窗",
        "选用规则": [
          "用户执行审批同意，且需求要求在弹窗内填写同意意见或补充材料时使用。"
        ],
        "模板": {
          "assetLink": "template.approval-agree-dialog"
        }
      },
      {
        "标题": "XFT 内容操作栏",
        "选用规则": [
          "需求明确需要在独立操作区放置作用于整个当前对象的操作，或用于完成当前任务的保存、提交、确认时使用。"
        ],
        "模板": {
          "assetLink": "template.content-action-bar"
        }
      },
      {
        "标题": "XFT 拖拽排序列表",
        "选用规则": [
          "用户需要手动调整一组条目的先后顺序时使用。需求明确要求直接在表格内调整顺序时，按表格内排序处理。"
        ],
        "模板": {
          "assetLink": "template.drag-sortable-list"
        }
      },
      {
        "标题": "XFT 筛选栏",
        "选用规则": [
          "筛选条件平铺在页面上、统一点击查询后才应用，且不需要筛选面板、表头筛选或常用方案时，必须使用 XFT 筛选栏。"
        ],
        "模板": {
          "assetLink": "template.filter-bar"
        }
      },
      {
        "标题": "XFT 筛选工作区",
        "选用规则": [
          "需求明确需要在面板内设置查询条件、在表头筛选列、选用常用筛选方案，或通过顶部快捷条件直接更新结果时，必须使用 XFT 筛选工作区。"
        ],
        "模板": {
          "assetLink": "template.filter-workbench"
        }
      },
      {
        "标题": "XFT 受管表格",
        "选用规则": [
          "只要需求明确需要用表格承载内容，就使用 XFT Pack 的受管表格，不直接使用 Ant Design 的 Table。"
        ],
        "模板": {
          "assetLink": "template.governed-table"
        }
      },
      {
        "标题": "XFT 信息卡片",
        "选用规则": [
          "需求明确以卡片列表或卡片视图逐条展示记录，且每张卡片对应一个可独立查看的对象时使用。"
        ],
        "模板": {
          "assetLink": "template.information-card"
        }
      },
      {
        "标题": "XFT 分区锚点",
        "选用规则": [
          "用户需要在同一份内容中按具名分区跳转定位时使用。"
        ],
        "模板": {
          "assetLink": "template.section-anchor"
        }
      },
      {
        "标题": "XFT 分组标题",
        "选用规则": [
          "表单或详情中的一组字段需要用标题标识其分组时使用。"
        ],
        "模板": {
          "assetLink": "template.section-heading"
        }
      },
      {
        "标题": "XFT 选择统计与分页栏",
        "选用规则": [
          "当前列表需要分页，或需要持续展示已选记录数量时使用。"
        ],
        "模板": {
          "assetLink": "template.selection-pagination-bar"
        }
      },
      {
        "标题": "XFT 统计卡片区",
        "选用规则": [
          "同一结果集按类别展示统计值，且用户可按这些类别切换结果时使用。仅切换不同内容视图用标签页，仅切换同一内容的互斥显示模式用分段选择器。"
        ],
        "模板": {
          "assetLink": "template.statistic-card-grid"
        }
      },
      {
        "标题": "XFT 汇总信息",
        "选用规则": [
          "需求明确要求把当前对象或范围的概况集中呈现为独立区块，并给出了具体摘要内容时使用。只有页面标题、单个状态字段，或正文已经展示的字段时，不新增汇总区。"
        ],
        "模板": {
          "assetLink": "template.summary-info"
        }
      },
      {
        "标题": "XFT 表格操作栏",
        "选用规则": [
          "需求明确需要对当前表格结果集执行新建、导入、导出、批量处理或刷新，或调整整张表格的排序、显示列时，必须使用 XFT 表格操作栏。"
        ],
        "模板": {
          "assetLink": "template.table-action-bar"
        }
      },
      {
        "标题": "XFT 范围选择面板",
        "选用规则": [
          "用户需要从独立面板选择业务范围，且选中范围决定相邻区域展示哪一批数据时使用。"
        ],
        "模板": {
          "assetLink": "template.context-selector-panel"
        }
      },
      {
        "标题": "XFT 表单内容",
        "选用规则": [
          "用户需要填写或编辑一组字段，并作为同一次任务进行校验、保存或提交时使用。"
        ],
        "模板": {
          "assetLink": "template.form-content"
        }
      }
    ]
  }
}
