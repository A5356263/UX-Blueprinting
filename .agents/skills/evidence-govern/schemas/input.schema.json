{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-govern-input.schema.json",
  "title": "Evidence Govern request 6.0.0",
  "type": "object",
  "required": [
    "artifact_type",
    "artifact_version",
    "source_mode",
    "invocation_context",
    "analysis_purpose",
    "requested_analyses",
    "input_bindings",
    "requested_deliverables",
    "publication_policy",
    "retention_policy",
    "upstream_artifact_refs",
    "archived_evidence_refs",
    "baseline_refs",
    "context_inputs",
    "outcome_patch_refs",
    "review_decisions"
  ],
  "properties": {
    "artifact_type": {"const": "evidence_govern_request"},
    "artifact_version": {"const": "6.0.0"},
    "requested_mode": {
      "type": ["string", "null"],
      "enum": [
        "evidence_governance",
        "outcome_patch_absorption",
        "review_decision_absorption",
        null
      ]
    },
    "source_mode": {
      "enum": ["explicit_input", "chain_context"]
    },
    "invocation_context": {"enum": ["independent", "chain_context"]},
    "analysis_purpose": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/analysis_purpose"},
    "requested_analyses": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/requested_analyses"},
    "input_bindings": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/input_bindings"},
    "requested_deliverables": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/requested_deliverables"},
    "publication_policy": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/publication_policy"},
    "retention_policy": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/retention_policy"},
    "project_name": {"type": "string"},
    "upstream_artifact_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["artifact_instance_ref", "handoff_ref", "payload_refs", "allowed_use"],
        "properties": {
          "artifact_instance_ref": {
            "$ref": "../../../../shared-workflow/data-analysis/schemas/artifact_instance_ref.schema.json"
          },
          "handoff_ref": {"type": "string", "pattern": "^#(?:/.*)?$"},
          "allowed_use": {"const": "evidence_governance"},
          "payload_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^#(?:/.*)?$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "prior_govern_result_ref": {"type": ["string", "null"]},
    "archived_evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "baseline_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "context_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["input_type"],
        "properties": {
          "input_type": {
            "enum": [
              "structured_package",
              "raw_file",
              "upstream_ref",
              "user_statement"
            ]
          },
          "source_ref": {"type": ["string", "null"]},
          "statement": {"type": ["string", "null"]},
          "declared_scope": {"type": ["object", "null"]},
          "sensitivity": {"enum": ["public", "internal", "confidential", "restricted", "unknown"]}
        },
        "additionalProperties": false
      }
    },
    "outcome_patch_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "review_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "review_id",
          "decision",
          "reviewer_ref",
          "decided_at",
          "rationale",
          "approved_actions"
        ],
        "properties": {
          "review_id": {"type": "string"},
          "decision": {
            "enum": ["approved", "rejected", "needs_more_information"]
          },
          "reviewer_ref": {"type": "string"},
          "decided_at": {"type": "string"},
          "rationale": {"type": "string"},
          "approved_actions": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
