<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>可视化用户旅程 - {{PROJECT_NAME}}</title>
<style>
:root {
  --bg: #ffffff;
  --text: #172033;
  --muted: #667085;
  --border: #d8dde8;
  --confirmed: #16a34a;
  --inferred: #64748b;
  --conflict: #f97316;
  --panel: #f8fafc;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: var(--bg);
  color: var(--text);
}
header { padding: 20px 24px 12px; border-bottom: 1px solid var(--border); }
h1 { margin: 0 0 8px; font-size: 22px; }
.meta { color: var(--muted); font-size: 13px; }
.tabs { display: flex; gap: 8px; padding: 16px 24px 0; flex-wrap: wrap; }
.tab {
  border: 1px solid var(--border);
  background: #fff;
  border-radius: 16px;
  padding: 6px 12px;
  cursor: pointer;
}
.tab.active { background: #1f2937; border-color: #1f2937; color: #fff; }
main { padding: 20px 24px 32px; }
.role { display: none; }
.role.active { display: block; }
.flow {
  display: flex;
  align-items: stretch;
  gap: 10px;
  overflow-x: auto;
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--panel);
}
.node {
  min-width: 150px;
  max-width: 210px;
  padding: 12px;
  background: #fff;
  border: 2px solid var(--confirmed);
  border-radius: 8px;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
}
.node.inferred { border-color: var(--inferred); border-style: dashed; }
.node.conflict { border-color: var(--conflict); }
.node-id { color: var(--muted); font-size: 12px; margin-bottom: 4px; }
.node-name { font-weight: 700; line-height: 1.35; }
.node-type { margin-top: 8px; color: var(--muted); font-size: 12px; }
.arrow { display: flex; align-items: center; color: var(--muted); font-size: 24px; }
.legend { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 14px; color: var(--muted); font-size: 13px; }
.legend span::before {
  content: "";
  display: inline-block;
  width: 12px;
  height: 12px;
  border: 2px solid var(--confirmed);
  border-radius: 4px;
  margin-right: 5px;
  vertical-align: -2px;
}
.legend .inferred::before { border-color: var(--inferred); border-style: dashed; }
.legend .conflict::before { border-color: var(--conflict); }
@media (max-width: 720px) {
  .flow { flex-direction: column; overflow-x: visible; }
  .arrow { justify-content: center; transform: rotate(90deg); }
  .node { max-width: none; }
}
</style>
</head>
<body>
<header>
  <h1>{{TITLE}}</h1>
  <div class="meta">{{SUMMARY}}</div>
</header>
<nav class="tabs" id="tabs"></nav>
<main id="app"></main>
<script>
const journeyRoles = {{JOURNEY_ROLES_JSON}};
const tabs = document.getElementById('tabs');
const app = document.getElementById('app');

function render() {
  tabs.innerHTML = '';
  app.innerHTML = '';
  journeyRoles.forEach((role, index) => {
    const button = document.createElement('button');
    button.className = 'tab' + (index === 0 ? ' active' : '');
    button.textContent = role.role;
    button.onclick = () => activate(index);
    tabs.appendChild(button);

    const section = document.createElement('section');
    section.className = 'role' + (index === 0 ? ' active' : '');
    const flow = document.createElement('div');
    flow.className = 'flow';
    role.nodes.forEach((node, nodeIndex) => {
      const card = document.createElement('article');
      card.className = 'node ' + (node.source || 'confirmed');
      card.title = node.detail || '';
      card.innerHTML = `
        <div class="node-id">${escapeHtml(node.node_id || '')}</div>
        <div class="node-name">${escapeHtml(node.node_name || '')}</div>
        <div class="node-type">${escapeHtml(node.node_type || '')} · ${escapeHtml(node.source || 'confirmed')}</div>
      `;
      flow.appendChild(card);
      if (nodeIndex < role.nodes.length - 1) {
        const arrow = document.createElement('div');
        arrow.className = 'arrow';
        arrow.textContent = '→';
        flow.appendChild(arrow);
      }
    });
    section.appendChild(flow);
    section.insertAdjacentHTML('beforeend', '<div class="legend"><span>confirmed</span><span class="inferred">inferred</span><span class="conflict">conflict</span></div>');
    app.appendChild(section);
  });
}

function activate(index) {
  document.querySelectorAll('.tab').forEach((el, i) => el.classList.toggle('active', i === index));
  document.querySelectorAll('.role').forEach((el, i) => el.classList.toggle('active', i === index));
}

function escapeHtml(value) {
  return String(value).replace(/[&<>"']/g, char => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  }[char]));
}

render();
</script>
</body>
</html>
