{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outcome-validation-input.schema.json",
  "title": "Outcome Validation Input 4.0.0",
  "type": "object",
  "required": [
    "run",
    "invocation_context",
    "analysis_purpose",
    "requested_analyses",
    "input_bindings",
    "requested_deliverables",
    "publication_policy",
    "retention_policy",
    "root_artifact_instance_ref",
    "root_cause_handoff",
    "root_cause_context",
    "intervention_contract",
    "govern_artifact_instance_ref",
    "govern_handoff",
    "governed_validation_evidence",
    "business_impact_refs",
    "review_decisions"
  ],
  "properties": {
    "invocation_context": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/invocation_context"},
    "analysis_purpose": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/analysis_purpose"},
    "requested_analyses": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/requested_analyses"},
    "input_bindings": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/input_bindings"},
    "requested_deliverables": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/requested_deliverables"},
    "publication_policy": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/publication_policy"},
    "retention_policy": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/retention_policy"},
    "root_artifact_instance_ref": {
      "$ref": "../../../../shared-workflow/data-analysis/schemas/artifact_instance_ref.schema.json"
    },
    "govern_artifact_instance_ref": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "../../../../shared-workflow/data-analysis/schemas/artifact_instance_ref.schema.json"}
      ]
    },
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "project_name",
        "validation_mode",
        "validation_stage",
        "source_mode",
        "requested_at"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "project_name": {"type": "string"},
        "validation_mode": {
          "enum": [
            "readiness_validation",
            "effectiveness_validation",
            "durability_monitoring"
          ]
        },
        "validation_stage": {
          "enum": [
            "pre_launch",
            "demo",
            "pilot",
            "post_launch",
            "long_term",
            "regression_monitoring"
          ]
        },
        "source_mode": {"enum": ["explicit_input", "chain_context"]},
        "requested_at": {"type": "string"}
      },
      "additionalProperties": false
    },
    "root_cause_handoff": {
      "allOf": [
        {
          "$ref": "../../../../shared-workflow/data-analysis/schemas/downstream_handoff.schema.json"
        },
        {
          "properties": {
          "target_skill": {"const": "outcome-validation-recheck"},
            "handoff_type": {"const": "root_cause_hypothesis_for_outcome"}
          }
        }
      ]
    },
    "root_cause_context": {
      "type": "object",
      "required": ["candidate_refs", "validation_hypothesis_refs", "causal_caveats"],
      "properties": {
        "candidate_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "validation_hypothesis_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "causal_caveats": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "intervention_contract": {"$ref": "#/$defs/interventionContract"},
    "govern_handoff": {
      "anyOf": [
        {"type": "null"},
        {
          "allOf": [
            {
              "$ref": "../../../../shared-workflow/data-analysis/schemas/downstream_handoff.schema.json"
            },
            {
              "properties": {
              "target_skill": {"const": "outcome-validation-recheck"},
                "handoff_type": {"const": "governed_evidence_for_outcome"}
              }
            }
          ]
        }
      ]
    },
    "governed_validation_evidence": {
      "type": "object",
      "required": [
        "evidence_refs",
        "baseline_refs",
        "observation_window_ref",
        "core_metric_refs",
        "guardrail_metric_refs",
        "segment_refs",
        "context_factor_refs",
        "business_rule_basis_refs",
        "data_quality_status"
      ],
      "properties": {
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "baseline_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "observation_window_ref": {"type": ["string", "null"]},
        "core_metric_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "guardrail_metric_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "segment_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "context_factor_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "business_rule_basis_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "data_quality_status": {
          "enum": ["ready", "ready_with_caveats", "partial", "blocked", "unknown"]
        }
      },
      "additionalProperties": false
    },
    "business_impact_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "review_decisions": {
      "type": "array",
      "items": {
        "$ref": "../../../../shared-workflow/data-analysis/schemas/review_decision.schema.json"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "run": {
            "properties": {"validation_mode": {"const": "readiness_validation"}},
            "required": ["validation_mode"]
          }
        }
      },
      "then": {
        "properties": {
          "run": {
            "properties": {"validation_stage": {"enum": ["pre_launch", "demo"]}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run": {
            "properties": {"validation_mode": {"const": "effectiveness_validation"}},
            "required": ["validation_mode"]
          }
        }
      },
      "then": {
        "properties": {
          "run": {
            "properties": {"validation_stage": {"enum": ["pilot", "post_launch"]}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run": {
            "properties": {"validation_mode": {"const": "durability_monitoring"}},
            "required": ["validation_mode"]
          }
        }
      },
      "then": {
        "properties": {
          "run": {
            "properties": {
              "validation_stage": {"enum": ["long_term", "regression_monitoring"]}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "interventionContract": {
      "type": "object",
      "required": [
        "intervention_id",
        "source_ref",
        "version",
        "solution_source_type",
        "linked_root_cause_candidate_refs",
        "intended_mechanism",
        "change_scope",
        "target_population",
        "validation_stage",
        "exposure_definition",
        "implementation_fidelity_definition",
        "target_metric_refs",
        "guardrail_metric_refs",
        "approval_status",
        "caveats"
      ],
      "properties": {
        "intervention_id": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "solution_source_type": {
          "enum": ["experience_blueprint", "user_confirmed_solution", "formal_plan"]
        },
        "linked_root_cause_candidate_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "intended_mechanism": {"type": "string", "minLength": 1},
        "change_scope": {"type": "object"},
        "target_population": {"type": "object"},
        "validation_stage": {
          "enum": [
            "pre_launch",
            "demo",
            "pilot",
            "post_launch",
            "long_term",
            "regression_monitoring"
          ]
        },
        "exposure_definition": {"type": "object"},
        "implementation_fidelity_definition": {"type": "object"},
        "target_metric_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "guardrail_metric_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "approval_status": {
          "enum": ["pending", "approved", "approved_with_caveats", "rejected"]
        },
        "caveats": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
