{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-proto.local/schemas/distribution-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "name", "version", "commonInstructionDigest", "runtimeLockDigest", "pack", "files", "contentDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "ux-proto-distribution-receipt" },
    "name": { "enum": ["ux-proto", "ux-proto-g"] },
    "version": { "const": "1.0.0" },
    "commonInstructionDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "runtimeLockDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "contentDigest"],
      "properties": {
        "id": { "const": "xft" },
        "version": { "const": "0.7.0" },
        "contentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "contentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
