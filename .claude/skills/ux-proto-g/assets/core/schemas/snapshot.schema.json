{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-proto.local/schemas/snapshot-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatorVersion", "pack", "baseline", "recommendations", "review", "runtimeTheme", "scope", "projection", "records", "assetCatalog", "publicSurface", "files", "contentDigest"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "ux-proto-resolved-assets" },
    "generatorVersion": { "type": "string" },
    "pack": { "type": "object" },
    "baseline": { "type": "object" },
    "recommendations": { "type": "array" },
    "review": { "type": "object" },
    "runtimeTheme": { "type": "object" },
    "scope": { "type": "object" },
    "projection": { "type": "array" },
    "records": { "type": "array" },
    "assetCatalog": { "type": "array" },
    "publicSurface": { "type": "array" },
    "files": { "type": "object" },
    "contentDigest": { "type": "string" }
  }
}
