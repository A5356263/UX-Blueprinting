{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-proto.local/schemas/resolver-report-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "roots", "closure", "diagnostics", "drift"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["resolved", "failed"] },
    "roots": { "type": "array" },
    "closure": { "type": "array" },
    "diagnostics": { "type": "array" },
    "drift": { "type": "object" }
  }
}
