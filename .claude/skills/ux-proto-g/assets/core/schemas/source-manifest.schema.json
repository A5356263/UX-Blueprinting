{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-proto.local/schemas/source-manifest-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "type", "version", "note", "consumption"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "const": "pack" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "note": { "type": "string", "minLength": 1 },
    "consumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "recommendations", "review"],
      "properties": {
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "artifact"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "artifact": { "type": "string", "minLength": 1 }
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "assetId"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "assetId": { "type": "string", "pattern": "^(knowledge|pattern|template|component)\\.[a-z0-9]+(?:-[a-z0-9]+)*$" }
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assets"],
          "properties": {
            "assets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^knowledge\\.[a-z0-9]+(?:-[a-z0-9]+)*$" } }
          }
        }
      }
    },
    "runtimeTheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts"],
      "properties": {
        "artifacts": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
