{
  "schemaVersion": 2,
  "id": "pattern.search-filter-configuration",
  "kind": "Pattern",
  "lifecycle": "active",
  "name": "Search Filter Configuration",
  "summary": "Configure which search criteria are enabled and their operators and default values.",
  "selection": {
    "useWhen": [
      "search fields operators and default values"
    ],
    "avoidWhen": [
      "table column visibility"
    ]
  },
  "relations": [
    {
      "type": "requires",
      "target": "knowledge.column-settings-vs-filters"
    },
    {
      "type": "requires",
      "target": "knowledge.filter-defaults"
    }
  ],
  "requires": [],
  "content": {
    "defaultOrder": [
      "filter-catalog",
      "filter-editor",
      "query-preview"
    ],
    "forbiddenCombinations": [
      "Treat table column presentation as query configuration"
    ],
    "optionalRegions": [
      {
        "id": "query-preview",
        "responsibility": "Explain the resulting query configuration."
      }
    ],
    "pageOwns": [
      "filter schema",
      "operator choices",
      "default values",
      "query execution",
      "optional persistence outside the prototype component"
    ],
    "referenceRefs": [],
    "requiredRegions": [
      {
        "id": "filter-catalog",
        "responsibility": "Choose available business fields."
      },
      {
        "id": "filter-editor",
        "responsibility": "Edit enabled state, operator, and default value."
      }
    ],
    "styleUses": [
      "outlined-container"
    ],
    "task": "Configure reusable search criteria."
  }
}
