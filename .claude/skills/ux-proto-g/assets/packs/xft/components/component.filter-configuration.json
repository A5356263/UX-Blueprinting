{
  "schemaVersion": 2,
  "id": "component.filter-configuration",
  "kind": "Pack Component",
  "lifecycle": "active",
  "name": "XFT Filter Configuration",
  "summary": "XFT-shaped prototype editor for enabling filters and setting operators and default values.",
  "selection": {
    "useWhen": ["an XFT list prototype needs editable filter configuration"],
    "avoidWhen": ["the task only needs an ordinary filter bar or production integration"]
  },
  "relations": [{"type": "recommended-for", "target": "pattern.search-filter-configuration"}],
  "requires": [],
  "entry": "XftFilterConfiguration.tsx",
  "artifacts": [],
  "api": {
    "mainExport": "XftFilterConfiguration",
    "properties": [
      {"name": "fields", "type": "XftFilterField[]", "required": true, "default": null, "description": "Available filter field definitions."},
      {"name": "value", "type": "XftFilterSetting[]", "required": true, "default": null, "description": "Current in-memory filter settings."},
      {"name": "defaults", "type": "XftFilterSetting[]", "required": true, "default": null, "description": "Settings restored by the local reset action."},
      {"name": "onChange", "type": "(next: XftFilterSetting[]) => void", "required": true, "default": null, "description": "Receives the next in-memory filter settings."}
    ],
    "types": [
      {
        "name": "XftFilterField",
        "properties": [
          {"name": "key", "type": "string", "required": true, "default": null, "description": "Stable field key."},
          {"name": "label", "type": "string", "required": true, "default": null, "description": "Visible field label."},
          {"name": "operators", "type": "XftFilterOperator[]", "required": true, "default": null, "description": "Operators available for the field."}
        ]
      },
      {
        "name": "XftFilterSetting",
        "properties": [
          {"name": "key", "type": "string", "required": true, "default": null, "description": "Field key associated with the setting."},
          {"name": "enabled", "type": "boolean", "required": true, "default": null, "description": "Whether the field participates in the prototype filter."},
          {"name": "operator", "type": "XftFilterOperator", "required": true, "default": null, "description": "Selected comparison operator."},
          {"name": "defaultValue", "type": "string", "required": true, "default": null, "description": "Prototype default value."}
        ]
      }
    ]
  },
  "usage": {
    "componentOwns": ["prototype filter enablement presentation", "operator selection presentation", "default-value editing", "local reset action"],
    "consumerProvides": ["available field definitions", "current values and defaults", "change handler"],
    "doesNotOwn": ["backend field schema", "query execution", "persistence", "permissions", "production API compatibility"],
    "guidance": ["Use it for an in-memory prototype editor, not as a production filter contract."],
    "limitations": ["Saved templates, remote schemas, complex grouping, drag ordering, and production integration are outside this component."]
  }
}
