{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subjective-feedback-analysis.output.schema.json",
  "title": "Subjective Evidence Package 4.0.0",
  "type": "object",
  "required": ["run", "scope", "source_summary", "privacy", "data_quality", "analysis_results", "findings", "evidence_items", "knowledge_candidates", "limitations", "publication", "delivery", "handoff"],
  "properties": {
    "run": {"$ref": "#/$defs/run"},
    "scope": {"type": "object"},
    "source_summary": {"$ref": "#/$defs/sourceSummary"},
    "privacy": {"$ref": "#/$defs/privacy"},
    "data_quality": {"$ref": "#/$defs/dataQuality"},
    "analysis_results": {"$ref": "#/$defs/analysisResults"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "evidence_items": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "knowledge_candidates": {"type": "array", "items": {"$ref": "#/$defs/knowledgeCandidate"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "publication": {"$ref": "../../../../shared-workflow/data-analysis/schemas/context_handoff.schema.json#/properties/publication"},
    "delivery": {"$ref": "../../../../shared-workflow/data-analysis/schemas/context_handoff.schema.json#/properties/delivery"},
    "handoff": {"$ref": "#/$defs/handoff"}
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": ["run_id", "artifact_type", "artifact_version", "producer_skill", "project_name", "generated_at", "source_mode", "analysis_mode", "status", "sources", "combined_input_fingerprint", "write_status", "invocation_context", "analysis_purpose"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^sfa_"},
        "artifact_type": {"const": "subjective_evidence_package"},
        "artifact_version": {"const": "4.0.0"},
        "producer_skill": {"const": "subjective-feedback-analysis"},
        "project_name": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "minLength": 1},
        "source_mode": {"enum": ["independent", "chain_context"]},
        "analysis_mode": {"enum": ["discovery", "comparative_analysis"]},
        "status": {"enum": ["completed", "completed_with_caveats"]},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/sourceManifest"}},
        "upstream_refs": {"type": "array", "items": {"type": "string"}},
        "combined_input_fingerprint": {"type": "string", "minLength": 1},
        "write_status": {"enum": ["written", "partial", "failed", "not_requested"]},
        "legacy_contract": {"const": false},
        "invocation_context": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/invocation_context"},
        "analysis_purpose": {"$ref": "../../../../shared-workflow/data-analysis/schemas/analysis_request.schema.json#/properties/analysis_purpose"}
      },
      "additionalProperties": false
    },
    "sourceManifest": {
      "type": "object",
      "required": ["source_id", "source_type", "status", "input_count"],
      "properties": {
        "source_id": {"type": "string"},
        "source_type": {"type": "string"},
        "channel": {"type": ["string", "null"]},
        "format": {"type": ["string", "null"]},
        "status": {"enum": ["loaded", "partially_loaded", "unreadable"]},
        "input_count": {"type": "integer", "minimum": 0},
        "fingerprint": {"type": ["string", "null"]},
        "failure_reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "sourceSummary": {
      "type": "object",
      "required": ["input_count", "valid_count", "excluded_count", "duplicate_count", "channel_distribution", "time_windows"],
      "properties": {
        "input_count": {"type": "integer", "minimum": 0},
        "valid_count": {"type": "integer", "minimum": 0},
        "excluded_count": {"type": "integer", "minimum": 0},
        "duplicate_count": {"type": "integer", "minimum": 0},
        "channel_distribution": {"type": "object"},
        "language_distribution": {"type": "object"},
        "time_windows": {"type": "array"},
        "deduplication_unit": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": ["pii_detected", "redaction_applied", "risk_types", "manual_review_required", "unredacted_text_persisted"],
      "properties": {
        "pii_detected": {"type": "boolean"},
        "redaction_applied": {"type": "boolean"},
        "risk_types": {"type": "array", "items": {"type": "string"}},
        "redaction_summary": {"type": "object"},
        "manual_review_items": {"type": "array"},
        "manual_review_required": {"type": "boolean"},
        "unredacted_text_persisted": {"const": false}
      },
      "additionalProperties": false
    },
    "dataQuality": {
      "type": "object",
      "required": ["status", "field_gaps", "thread_completeness", "channel_coverage", "channel_bias_risks", "sample_boundary", "classification_rule_version"],
      "properties": {
        "status": {"enum": ["ready", "ready_with_caveats"]},
        "field_gaps": {"type": "array"},
        "thread_completeness": {"enum": ["complete", "partial", "unknown"]},
        "channel_coverage": {"type": "array"},
        "channel_bias_risks": {"type": "array"},
        "sample_boundary": {"type": "string"},
        "classification_rule_version": {"const": "ticket-experience-v1.0"},
        "translation_or_semantic_risks": {"type": "array"},
        "segment_coverage": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    },
    "analysisResults": {
      "type": "object",
      "required": ["ticket_screening", "normalized_feedback_items", "theme_clusters", "sentiment_summary", "analysis_attention_items", "mapping_summary", "business_rule_signals", "comparison", "objective_validation_requests", "nps_summary"],
      "properties": {
        "ticket_screening": {"type": "array", "items": {"$ref": "#/$defs/ticketScreening"}},
        "normalized_feedback_items": {"type": "array", "items": {"$ref": "#/$defs/feedbackItem"}},
        "theme_clusters": {"type": "array", "items": {"$ref": "#/$defs/themeCluster"}},
        "sentiment_summary": {"type": "object"},
        "analysis_attention_items": {"type": "array", "items": {"$ref": "#/$defs/attentionItem"}},
        "mapping_summary": {"type": "object"},
        "business_rule_signals": {"type": "array", "items": {"$ref": "#/$defs/businessRuleBasis"}},
        "comparison": {"oneOf": [{"$ref": "#/$defs/comparison"}, {"type": "null"}]},
        "objective_validation_requests": {"type": "array", "items": {"$ref": "#/$defs/objectiveRequest"}}
        ,"nps_summary": {"$ref": "#/$defs/npsSummary"}
        ,"sample_slices": {"type": "array", "items": {"$ref": "#/$defs/sampleSlice"}}
      },
      "additionalProperties": false
    },
    "npsSummary": {
      "type": "object",
      "required": ["status", "overall", "slices", "reliability", "limitations"],
      "properties": {
        "status": {"enum": ["completed", "completed_with_caveats", "not_evaluable"]},
        "reason": {"type": "string"},
        "overall": {"oneOf": [{"$ref": "#/$defs/npsFact"}, {"type": "null"}]},
        "slices": {"type": "array", "items": {"$ref": "#/$defs/npsFact"}},
        "reliability": {"type": "object"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "npsFact": {
      "type": "object",
      "required": ["measurement_scope", "response_count", "promoter_count", "passive_count", "detractor_count", "nps", "response_rate"],
      "properties": {
        "measurement_scope": {
          "type": "object",
          "required": ["grain", "dimensions"],
          "properties": {
            "grain": {"const": "survey_response"},
            "dimensions": {
              "type": "object",
              "propertyNames": {"enum": ["business_board", "enterprise_state"]},
              "additionalProperties": {"type": "string"}
            }
          },
          "additionalProperties": false
        },
        "response_count": {"type": "integer", "minimum": 0},
        "promoter_count": {"type": "integer", "minimum": 0},
        "passive_count": {"type": "integer", "minimum": 0},
        "detractor_count": {"type": "integer", "minimum": 0},
        "nps": {"type": ["number", "null"], "minimum": -100, "maximum": 100},
        "response_rate": {
          "type": "object",
          "required": ["status", "numerator", "denominator", "value"],
          "properties": {
            "status": {"enum": ["available", "not_evaluable"]},
            "numerator": {"type": "integer", "minimum": 0},
            "denominator": {"type": ["integer", "null"], "minimum": 0},
            "value": {"type": ["number", "null"], "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sampleSlice": {
      "type": "object",
      "required": ["slice_id", "dimensions", "sample_count", "sample_share", "sample_status", "mapping_basis", "interpretation_boundary"],
      "properties": {
        "slice_id": {"type": "string", "pattern": "^sfsl_"},
        "dimensions": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 3,
          "propertyNames": {"enum": ["product_module", "page", "function", "operation_node", "channel", "enterprise_group", "explicit_business_field"]},
          "additionalProperties": {"type": "string"}
        },
        "sample_count": {"type": "integer", "minimum": 0},
        "sample_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "sample_status": {"enum": ["sufficient", "low_sample_risk"]},
        "mapping_basis": {"enum": ["explicit_field", "explicit_text", "formal_business_mapping", "uxb_mapping", "inferred", "mixed"]},
        "mapping_confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "theme_refs": {"type": "array", "items": {"type": "string", "pattern": "^sfc_"}},
        "interpretation_boundary": {"const": "current_feedback_sample_only_not_objective_prevalence"}
      },
      "additionalProperties": false
    },
    "ticketScreening": {
      "type": "object",
      "required": ["source_item_id", "relevance_status", "experience_issue_labels", "reason", "classification_confidence"],
      "properties": {
        "source_item_id": {"type": "string"},
        "relevance_status": {"enum": ["experience_related", "possibly_experience_related", "not_experience_focused", "not_evaluable"]},
        "experience_issue_labels": {"type": "array", "items": {"enum": ["visual_flow", "interaction_process", "information_communication", "negative_experience_signal", "interface_interaction_anomaly", "error_failure_feedback"]}},
        "reason": {"type": "string"},
        "classification_confidence": {"enum": ["high", "medium", "low"]},
        "non_experience_route": {"enum": ["business_rule_question", "feature_request", "service_operation_issue", "objective_log_only", "duplicate_or_noise", "insufficient_context", "not_applicable"]}
      },
      "additionalProperties": false
    },
    "feedbackItem": {
      "type": "object",
      "required": ["item_id", "source_ref", "channel", "speaker_role", "redacted_text", "language", "privacy_flags"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^sfi_"},
        "source_ref": {"type": "string"},
        "thread_ref": {"type": ["string", "null"]},
        "channel": {"type": "string"},
        "timestamp": {"type": ["string", "null"]},
        "speaker_role": {"enum": ["user", "operator", "customer_service", "researcher", "system_message_quoted", "unknown"]},
        "redacted_text": {"type": "string"},
        "language": {"type": "string"},
        "privacy_flags": {"type": "array", "items": {"type": "string"}},
        "enterprise_id": {"type": ["string", "null"]},
        "enterprise_name": {"type": ["string", "null"]},
        "segment_values": {"type": "object"},
        "product_location": {
          "type": "object",
          "properties": {
            "product_module": {"type": ["string", "null"]},
            "page": {"type": ["string", "null"]},
            "function": {"type": ["string", "null"]},
            "operation_node": {"type": ["string", "null"]},
            "mapping_basis": {"enum": ["explicit_field", "explicit_text", "formal_business_mapping", "uxb_mapping", "inferred", "unknown"]},
            "mapping_confidence": {"enum": ["high", "medium", "low", "unknown"]}
          },
          "additionalProperties": false
        },
        "issue_type_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["flow_blockage", "permission_or_configuration", "information_display", "missing_capability", "efficiency_cost", "business_rule_logic", "collaboration", "other"]}
        }
      },
      "additionalProperties": false
    },
    "quote": {
      "type": "object",
      "required": ["quote_id", "source_item_id", "redacted_text"],
      "properties": {
        "quote_id": {"type": "string", "pattern": "^sfq_"},
        "source_item_id": {"type": "string"},
        "redacted_text": {"type": "string"}
      },
      "additionalProperties": false
    },
    "themeCluster": {
      "type": "object",
      "required": ["cluster_id", "label", "source_item_ids", "sample_count", "sample_share", "channels", "representative_quotes", "confidence", "bias_notes"],
      "properties": {
        "cluster_id": {"type": "string", "pattern": "^sfc_"},
        "label": {"type": "string"},
        "source_item_ids": {"type": "array", "items": {"type": "string"}},
        "sample_count": {"type": "integer", "minimum": 0},
        "sample_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "channels": {"type": "array", "items": {"type": "string"}},
        "representative_quotes": {"type": "array", "items": {"$ref": "#/$defs/quote"}},
        "affected_pages": {"type": "array", "items": {"type": "string"}},
        "affected_flows": {"type": "array", "items": {"type": "string"}},
        "affected_journey_steps": {"type": "array", "items": {"type": "string"}},
        "confidence": {"enum": ["high", "medium", "low"]},
        "bias_notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "attentionItem": {
      "type": "object",
      "required": ["attention_id", "cluster_ref", "level", "basis"],
      "properties": {
        "attention_id": {"type": "string"},
        "cluster_ref": {"type": "string"},
        "level": {"enum": ["high_attention", "medium_attention", "low_attention", "needs_review"]},
        "basis": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["finding_id", "cluster_ref", "claim_type", "statement", "source_item_ids", "sample_count", "sample_share", "confidence", "evidence_eligible"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^sff_"},
        "cluster_ref": {"type": "string"},
        "claim_type": {"enum": ["sample_observation", "association", "hypothesis"]},
        "statement": {"type": "string"},
        "source_item_ids": {"type": "array", "items": {"type": "string"}},
        "sample_count": {"type": "integer", "minimum": 0},
        "sample_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "confidence": {"enum": ["high", "medium", "low"]},
        "evidence_eligible": {"type": "boolean"},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "business_loss_signal": {"enum": ["explicitly_reported", "not_reported"]},
        "business_loss_description": {"type": ["string", "null"]},
        "business_loss_source_item_ids": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"properties": {"claim_type": {"const": "hypothesis"}}},
          "then": {"properties": {"evidence_eligible": {"const": false}}}
        }
      ],
      "additionalProperties": false
    },
    "businessRuleBasis": {
      "type": "object",
      "required": ["basis_id", "source_type", "source_detail", "source_ref", "rule_type", "applicable_scope", "confidence", "confirmation_status", "description", "allowed_uses", "forbidden_uses"],
      "properties": {
        "basis_id": {"type": "string", "pattern": "^sfbr_"},
        "source_type": {"enum": ["user_confirmed", "formal_upstream", "knowledge_wiki", "explicit_project_rule", "skill_reference", "provided_material", "evidence_inferred", "unknown"]},
        "source_detail": {"enum": ["user_confirmed", "formal_upstream", "manual_config", "blueprint_candidate", "knowledge_candidate", "evidence_inferred", "unknown"]},
        "source_ref": {"type": ["string", "null"]},
        "source_version": {"type": ["string", "null"]},
        "rule_type": {"enum": ["allowed_repeat", "expected_backtrack", "required_step", "optional_step", "validation_rule", "exception_flow", "eligibility_rule", "policy_constraint", "configuration_rule", "scenario_rule"]},
        "applicable_scope": {"type": "object"},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "confirmation_status": {"enum": ["confirmed", "confirmed_for_current_run", "candidate", "inferred", "unknown"]},
        "description": {"type": "string"},
        "allowed_uses": {"type": "array", "items": {"type": "string"}},
        "forbidden_uses": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "sceneDescriptor": {
      "type": "object",
      "required": ["where", "what", "operation", "who", "source_attribution", "evidence_form"],
      "properties": {
        "where": {"type": ["string", "null"]},
        "what": {"type": ["string", "null"]},
        "operation": {"type": ["string", "null"]},
        "who": {
          "type": "object",
          "required": ["actor_role", "user_segment", "stable_redacted_entity_ref"],
          "properties": {
            "actor_role": {"type": ["string", "null"]},
            "user_segment": {"type": ["string", "null"]},
            "stable_redacted_entity_ref": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "when": {"type": ["string", "null"]},
        "source_attribution": {"enum": ["user_verbatim", "support_agent_summary", "ops_curated", "researcher_summary", "user_quoted_system_message", "support_quoted_system_message", "unknown"]},
        "evidence_form": {"enum": ["ticket_description", "group_chat", "survey_response", "interview_excerpt", "public_review", "operation_note", "customer_success_note", "embedded_feedback"]}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "finding_ref", "cluster_ref", "claim_type", "statement", "source_item_ids", "representative_quote_refs", "sample_count", "sample_share", "confidence", "scene_descriptor", "privacy_status", "manual_review_required", "allowed_uses", "forbidden_uses", "lineage"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^sfe_"},
        "finding_ref": {"type": "string"},
        "cluster_ref": {"type": "string"},
        "claim_type": {"enum": ["user_report", "perception_signal", "service_signal", "sentiment_signal", "reported_error"]},
        "statement": {"type": "string"},
        "source_item_ids": {"type": "array", "items": {"type": "string"}},
        "representative_quote_refs": {"type": "array", "items": {"type": "string"}},
        "sample_count": {"type": "integer", "minimum": 0},
        "sample_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "affected_pages": {"type": "array", "items": {"type": "string"}},
        "affected_flows": {"type": "array", "items": {"type": "string"}},
        "affected_journey_steps": {"type": "array", "items": {"type": "string"}},
        "confidence": {"enum": ["high", "medium", "low"]},
        "scene_descriptor": {"$ref": "#/$defs/sceneDescriptor"},
        "business_rule_basis": {"oneOf": [{"$ref": "#/$defs/businessRuleBasis"}, {"type": "null"}]},
        "privacy_status": {"enum": ["safe", "restricted", "needs_review", "blocked"]},
        "manual_review_required": {"type": "boolean"},
        "allowed_uses": {"type": "array", "items": {"type": "string"}},
        "forbidden_uses": {"type": "array", "items": {"enum": ["prevalence_claim", "causal_claim", "final_root_cause", "objective_impact_scale", "intervention_effectiveness", "knowledge_publish"]}},
        "lineage": {
          "type": "object",
          "required": ["run_id", "input_fingerprint"],
          "properties": {"run_id": {"type": "string"}, "input_fingerprint": {"type": "string"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "objectiveRequest": {
      "type": "object",
      "required": ["objective_request_id", "related_finding_refs", "related_evidence_refs", "hypothesis", "falsification_condition", "requested_signal", "metric_refs", "denominator_definition", "scope", "priority", "reason", "target_skill", "requires_user_confirmation", "raw_feedback_included"],
      "properties": {
        "objective_request_id": {"type": "string", "pattern": "^sfor_"},
        "related_finding_refs": {"type": "array", "items": {"type": "string"}},
        "related_evidence_refs": {"type": "array", "items": {"type": "string"}},
        "hypothesis": {"type": "string"},
        "falsification_condition": {"type": "string", "minLength": 1},
        "requested_signal": {"type": "string"},
        "metric_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "denominator_definition": {"type": "string", "minLength": 1},
        "scope": {"type": "object"},
        "time_window": {"type": ["object", "null"]},
        "priority": {"enum": ["high", "medium", "low"]},
        "reason": {"type": "string"},
        "target_skill": {"const": "objective-data-analysis"},
        "requires_user_confirmation": {"type": "boolean"},
        "raw_feedback_included": {"const": false}
      },
      "additionalProperties": false
    },
    "knowledgeCandidate": {
      "type": "object",
      "required": ["knowledge_candidate_id", "candidate_type", "source_item_ids", "canonical_question", "answer_summary", "applicable_context", "required_conditions", "official_rule_confidence", "conflict_risk", "staleness_risk", "privacy_risk", "workaround_flag", "recommended_action", "manual_review_required"],
      "properties": {
        "knowledge_candidate_id": {"type": "string", "pattern": "^sfk_"},
        "candidate_type": {"enum": ["qa_candidate", "answer_pattern", "guidance_seed"]},
        "source_item_ids": {"type": "array", "items": {"type": "string"}},
        "canonical_question": {"type": "string"},
        "answer_summary": {"type": "string"},
        "applicable_context": {"type": "array", "items": {"type": "string"}},
        "required_conditions": {"type": "array", "items": {"type": "string"}},
        "official_rule_confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "conflict_risk": {"enum": ["high", "medium", "low"]},
        "staleness_risk": {"enum": ["high", "medium", "low"]},
        "privacy_risk": {"enum": ["high", "medium", "low"]},
        "workaround_flag": {"type": "boolean"},
        "recommended_action": {"enum": ["create_candidate", "merge_candidate", "update_candidate", "conflict_review", "stale_review", "privacy_review", "reject"]},
        "manual_review_required": {"const": true}
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "required": ["baseline_window", "comparison_window", "baseline_type", "reusable", "comparability_status", "theme_changes", "channel_changes", "limitations"],
      "properties": {
        "baseline_window": {"type": "object"},
        "comparison_window": {"type": "object"},
        "baseline_type": {"enum": ["formal_baseline_ref", "run_local_comparison"]},
        "reusable": {"type": "boolean"},
        "comparability_status": {"enum": ["comparable", "comparable_with_caveats", "not_comparable"]},
        "theme_changes": {"type": "array", "items": {"$ref": "#/$defs/comparisonItem"}},
        "channel_changes": {"type": "array", "items": {"$ref": "#/$defs/comparisonItem"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "comparisonItem": {
      "type": "object",
      "required": ["item_ref", "status", "baseline_sample_count", "comparison_sample_count"],
      "properties": {
        "item_ref": {"type": "string"},
        "status": {"enum": ["increased", "decreased", "stable", "newly_observed", "not_observed_in_current_sample", "shifted", "not_comparable"]},
        "baseline_sample_count": {"type": "integer", "minimum": 0},
        "comparison_sample_count": {"type": "integer", "minimum": 0},
        "baseline_sample_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "comparison_sample_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "required": ["next_skill", "input_gate_status", "handoff_status", "payload_refs", "evidence_refs", "business_impact_access", "visualization", "knowledge_review_request", "outcome_comparison_access", "archive_access", "allowed_uses", "forbidden_uses", "blocked_reasons"],
      "properties": {
        "next_skill": {"const": "evidence-govern"},
        "input_gate_status": {"enum": ["ready", "ready_with_caveats", "blocked"]},
        "handoff_status": {"enum": ["ready", "ready_with_caveats", "blocked"]},
        "payload_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^#/evidence_items/[0-9]+$"}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "business_impact_access": {
          "type": "object",
          "required": ["available_on_explicit_request", "evidence_path", "finding_path", "finding_maturity"],
          "properties": {
            "available_on_explicit_request": {"const": true},
            "evidence_path": {"const": "#/evidence_items"},
            "finding_path": {"const": "#/findings"},
            "finding_maturity": {"const": "problem_signal"}
          },
          "additionalProperties": false
        },
        "visualization": {"$ref": "../../../../shared-workflow/data-analysis/schemas/downstream_handoff.schema.json"},
        "knowledge_review_request": {
          "type": "object",
          "required": ["candidate_refs", "read_gate", "auto_publish_allowed"],
          "properties": {
            "candidate_refs": {"type": "array", "items": {"type": "string"}},
            "read_gate": {"enum": ["governance_release_or_explicit_user_review", "not_applicable"]},
            "auto_publish_allowed": {"const": false}
          },
          "additionalProperties": false
        },
        "outcome_comparison_access": {
          "type": "object",
          "required": ["requires_root_cause_and_intervention_contract", "comparison_path"],
          "properties": {
            "requires_root_cause_and_intervention_contract": {"const": true},
            "comparison_path": {"const": "#/analysis_results/comparison"}
          },
          "additionalProperties": false
        },
        "archive_access": {
          "type": "object",
          "required": ["governance_gate_required"],
          "properties": {"governance_gate_required": {"const": true}},
          "additionalProperties": false
        },
        "allowed_uses": {
          "type": "array",
          "items": {"type": "string"}
        },
        "forbidden_uses": {
          "type": "array",
          "items": {"enum": ["treat_findings_as_governed_evidence", "publish_knowledge", "claim_prevalence", "claim_root_cause", "claim_effectiveness", "recalculate_visualization", "archive_without_governance"]}
        },
        "blocked_reasons": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"run": {"properties": {"analysis_mode": {"const": "comparative_analysis"}}}}},
      "then": {"properties": {"analysis_results": {"properties": {"comparison": {"$ref": "#/$defs/comparison"}}}}}
    },
    {
      "if": {"properties": {"run": {"properties": {"analysis_mode": {"const": "discovery"}}}}},
      "then": {"properties": {"analysis_results": {"properties": {"comparison": {"type": "null"}}}}}
    }
  ],
  "additionalProperties": false
}
