{
  "name": "dsh-ux-blueprinting",
  "version": "0.4.4",
  "description": "会话式设计工作台：把 Skill 发进原生会话，保留执行时间线、产物与下一步。",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./reference-reader": "./runtime/reference-reader.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "skills-provider.js",
    "runtime/state.js",
    "runtime/artifacts.js",
    "runtime/workbench.js",
    "runtime/reference-reader.js",
    "runtime/orchestration.js",
    "runtime/preview.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    ".agents/skills/board/",
    ".agents/skills/business-impact/",
    ".agents/skills/data-visualization/",
    ".agents/skills/edge/",
    ".agents/skills/evidence-archive/",
    ".agents/skills/evidence-govern/",
    ".agents/skills/experience-heuristic-analysis/",
    ".agents/skills/journey-analysis/",
    ".agents/skills/journey-metrics/",
    ".agents/skills/knowledge-wiki/",
    ".agents/skills/objective-data-analysis/",
    ".agents/skills/outcome-validation-recheck/",
    ".agents/skills/page-spec/",
    ".agents/skills/prd-review/",
    ".agents/skills/problem-framing/",
    ".agents/skills/root-cause-synthesis/",
    ".agents/skills/solution-swimlane/",
    ".agents/skills/stories/",
    ".agents/skills/subjective-feedback-analysis/",
    ".agents/skills/uxb/",
    "shared-workflow/skill-graph.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
