  "task_contract": {
    "task_goal": [
      "为子管理员配置场景新增「复制」能力，解决集团型客户（200+ 子管理员）批量配置时重复勾选相同功能权限的效率问题。本次输出服务于产品评审与体验设计评审。"
    ],
    "task_scenario": [
      "场景类型：新建任务",
      "本次是基于较完整需求文档的新功能蓝图设计",
      "覆盖全链路：facts → business → experience"
    ],
    "execution_constraints": [
      "不得臆造业务事实",
      "信息不足处保留 `[GAP]`",
      "正式产出必须写入 `workspace/`",
      "不得用聊天回复替代正式文档产物",
      "facts 阶段不得把引用知识提升为当前任务的已确认事实",
      "business 阶段不得输出 UI 方案或实现方案",
      "experience 阶段不得输出高保真视觉稿或研发实现细节",
      "**阶段门禁**：每个阶段必须 gate 通过后才能进入下一阶段。不得在 facts gate 通过前生成 business_blueprint.md，不得在 business gate 通过前生成 experience_blueprint.md。不得一次性写完所有产物再回头补 gate。"
    ],
    "read_order": [
      "先读本文件",
      "再读 `Required Inputs`",
      "生成 facts.md（详见 `specs/08_fact_extraction_contract.md`）→ 运行 `python -m packages gate-facts sub-admin-copy`，通过才能进入下一步",
      "生成 business_blueprint.md（详见 `specs/09_business_blueprint_contract.md`）→ 运行 `python -m packages gate-business sub-admin-copy`，通过才能进入下一步",
      "生成 experience_blueprint.md（详见 `specs/10_experience_blueprint_contract.md`）→ 运行 `python -m packages gate-experience sub-admin-copy`，通过才能进入下一步",
      "运行 `python -m packages validate sub-admin-copy` 和 `python -m packages coverage sub-admin-copy`",
      "运行 `python -m packages archive sub-admin-copy`（产物镜像到 exports/）",
      "运行 `python -m packages preview sub-admin-copy --no-serve`（生成静态预览 HTML 到 runtime/preview/）"
    ],
    "notes": [
      "需求文档中等完整度，已与产品确认 4 项关键决策（互审时机、部分失败策略、去重逻辑、状态术语）",
      "仍有 4 项 `[GAP]` 不阻塞任务推进"
    ]
  },
