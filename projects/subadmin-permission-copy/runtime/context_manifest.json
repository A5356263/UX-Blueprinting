  "task_contract": {
    "task_goal": [
      "为子管理员模式新增「复制」能力，允许权限管理员将已有子管理员的「可授权组织」和「可授权功能」批量复制给最多 200 名用户",
      "解决集团型客户批量配置子管理员时重复勾选效率低的问题",
      "输出完整业务蓝图和体验蓝图，服务于产品评审和研发实现"
    ],
    "task_scenario": [
      "新建任务",
      "基于已确认的需求文档和诊断咨询结论，输出全链路正式产物（facts → business → experience）",
      "全链路覆盖"
    ],
    "execution_constraints": [
      "不得臆造业务事实",
      "信息不足处保留 `[GAP]`",
      "正式产出必须写入 `workspace/`",
      "不得用聊天回复替代正式文档产物",
      "facts 阶段不得把引用知识提升为当前任务的已确认事实",
      "business 阶段不得输出 UI 方案或实现方案",
      "experience 阶段不得输出高保真视觉稿或研发实现细节",
      "**阶段门禁**：每个阶段必须 gate 通过后才能进入下一阶段"
    ],
    "read_order": [
      "先读本文件",
      "再读 `Required Inputs`",
      "生成 facts.md（详见 `specs/08_fact_extraction_contract.md`）→ 运行 `python -m packages gate-facts subadmin-permission-copy`，通过才能进入下一步",
      "生成 business_blueprint.md（详见 `specs/09_business_blueprint_contract.md`）→ 运行 `python -m packages gate-business subadmin-permission-copy`，通过才能进入下一步",
      "生成 experience_blueprint.md（详见 `specs/10_experience_blueprint_contract.md`）→ 运行 `python -m packages gate-experience subadmin-permission-copy`，通过才能进入下一步",
      "运行 `python -m packages validate subadmin-permission-copy` 和 `python -m packages coverage subadmin-permission-copy`",
      "运行 `python -m packages archive subadmin-permission-copy`（产物镜像到 exports/）"
    ],
    "notes": [
      "基于已确认的需求文档和诊断咨询结论（10 个不明确事项中 1-7 已采纳，8-10 按现状不动）",
      "双管理员互审完整审批规则留待产品补充，蓝图阶段按状态模型设计"
    ]
  },
