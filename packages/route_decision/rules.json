{
  "version": "route-decision-rules@2.0",
  "default_demand_type": "不确定",
  "evidence_terms": ["目标", "需要", "支持", "新增", "优化", "调整", "重构", "权限", "状态", "文案", "布局"],
  "fallback_evidence": "未读取到足够明确的需求正文，请先由 UXB 做需求类型判断。",
  "negation_markers": ["不涉及", "不改变", "不新增", "不影响", "不用", "无需", "沿用现有", "只影响", "只补充", "只保留"],
  "signal_rules": [
    {
      "demand_type": "局部体验优化",
      "terms": ["体验优化", "微调", "小改", "局部", "可见性", "状态提示", "禁用按钮"],
      "evidence_label": "主要信号偏向局部体验表达",
      "signal_level": "low"
    },
    {
      "demand_type": "布局交互优化",
      "terms": ["布局", "拖动", "宽度", "展示密度", "默认展开", "响应", "按钮态"],
      "evidence_label": "主要信号偏向布局或局部交互",
      "signal_level": "low"
    },
    {
      "demand_type": "文案与信息表达优化",
      "terms": ["文案", "提示语", "说明", "命名", "tooltip", "空状态", "解释"],
      "evidence_label": "主要信号偏向文案或信息表达",
      "signal_level": "low"
    },
    {
      "demand_type": "信息结构与概念澄清",
      "terms": ["概念", "归属", "入口", "信息结构", "模块边界", "对象关系"],
      "evidence_label": "主要信号偏向概念或信息结构",
      "signal_level": "medium"
    },
    {
      "demand_type": "既有能力扩展",
      "terms": ["增加", "扩展", "导出", "批量", "配置项", "明细"],
      "evidence_label": "主要信号偏向既有能力扩展",
      "signal_level": "medium"
    },
    {
      "demand_type": "业务流程调整",
      "terms": ["流程", "提交", "撤回", "生效", "回写", "协同", "多角色"],
      "evidence_label": "主要信号偏向任务路径或业务流程调整",
      "signal_level": "high"
    },
    {
      "demand_type": "权限与治理风险",
      "terms": ["权限模型", "权限规则", "权限范围", "权限边界", "授权", "审批治理", "审批范围", "审批模式", "审计", "治理", "敏感", "数据范围", "可见范围"],
      "evidence_label": "主要信号偏向权限、数据范围、审批或治理风险",
      "signal_level": "high"
    },
    {
      "demand_type": "功能新增",
      "terms": ["新增功能", "新增能力", "新建模块", "增加入口", "新增页面", "新增模式", "自助申请", "自动授予"],
      "evidence_label": "主要信号偏向新增核心能力",
      "signal_level": "high"
    },
    {
      "demand_type": "功能重构",
      "terms": ["重构", "改造", "重新设计", "模型调整", "关系重构", "链路重构", "状态机"],
      "evidence_label": "主要信号偏向能力或模型重构",
      "signal_level": "high"
    }
  ],
  "dimension_fields": [
    "business_capability_change",
    "business_rule_change",
    "permission_governance_risk",
    "task_flow_change",
    "information_structure_pressure",
    "state_exception_pressure",
    "copy_comprehension_pressure",
    "layout_interaction_pressure",
    "review_risk"
  ],
  "dimension_rules": {
    "business_capability_change": {
      "terms": ["新增能力", "新增功能", "新建模块", "重构", "扩展"],
      "hit_reason": "业务能力发生变化或扩展",
      "miss_reason": "未发现新增或重构能力，更像现有能力内调整",
      "miss_level": "none",
      "default_hit_level": "minor",
      "value_triggers": [
        { "terms": ["重构", "新增能力", "新增功能"], "level": "major" }
      ]
    },
    "business_rule_change": {
      "terms": ["规则", "校验", "限制", "配置项", "范围", "必须", "允许", "禁止"],
      "hit_reason": "存在业务规则、校验或限制变化",
      "miss_reason": "未发现明确的业务规则变化",
      "miss_level": "none",
      "default_hit_level": "medium"
    },
    "permission_governance_risk": {
      "terms": ["权限模型", "权限规则", "权限范围", "权限边界", "授权", "审批治理", "审批范围", "审批模式", "审计", "治理", "数据范围", "敏感", "可见范围", "缺少权限", "超出当前权限"],
      "hit_reason": "涉及权限、审批、数据范围、导出或治理风险",
      "miss_reason": "未发现权限、审批或治理风险变化",
      "miss_level": "none",
      "default_hit_level": "high",
      "value_triggers": [
        { "terms": ["权限模型", "审批模式", "数据范围"], "level": "high" }
      ]
    },
    "task_flow_change": {
      "terms": ["流程", "步骤", "提交", "撤回", "生效", "回写", "协同", "多角色"],
      "hit_reason": "用户任务路径、结果回写或角色协同可能变化",
      "miss_reason": "未发现任务路径变化",
      "miss_level": "none",
      "default_hit_level": "medium",
      "value_triggers": [
        { "terms": ["多角色"], "level": "major" }
      ]
    },
    "information_structure_pressure": {
      "terms": ["概念", "定义", "归属", "入口", "层级", "模块", "关系", "分组", "信息结构"],
      "hit_reason": "存在概念、入口、层级或模块边界压力",
      "miss_reason": "未发现明显的信息结构压力",
      "miss_level": "none",
      "default_hit_level": "medium",
      "value_triggers": [
        { "terms": ["重构"], "level": "high" }
      ]
    },
    "state_exception_pressure": {
      "terms": ["状态机", "状态变化", "审批状态", "状态筛选", "异常", "失败", "部分成功", "阻断", "不可操作", "校验", "生效", "失效"],
      "hit_reason": "状态、异常、阻断或校验会影响方案",
      "miss_reason": "未发现明显的状态或异常压力",
      "miss_level": "none",
      "default_hit_level": "medium",
      "value_triggers": [
        { "terms": ["状态机", "阻断"], "level": "high" }
      ]
    },
    "copy_comprehension_pressure": {
      "terms": ["文案", "提示", "说明", "解释", "tooltip", "空状态", "命名", "看不懂"],
      "hit_reason": "用户理解主要依赖文案、说明或提示",
      "miss_reason": "未发现文案理解是主要压力",
      "miss_level": "low",
      "default_hit_level": "low"
    },
    "layout_interaction_pressure": {
      "terms": ["布局", "拖动", "宽度", "展示", "密度", "默认", "响应", "按钮", "区域"],
      "hit_reason": "局部布局、展示或交互细节是明显压力",
      "miss_reason": "未发现布局交互是主要压力",
      "miss_level": "low",
      "default_hit_level": "low"
    },
    "review_risk": {
      "terms": ["不清", "边界", "争议", "误解", "确认", "风险", "不确定", "可能"],
      "hit_reason": "存在边界争议、误解风险或待确认项",
      "miss_reason": "当前信息未暴露明显评审风险",
      "miss_level": "low",
      "default_hit_level": "medium"
    }
  },
  "pressure_labels": {
    "permission_governance_risk": "权限治理",
    "state_exception_pressure": "状态异常",
    "copy_comprehension_pressure": "文案理解",
    "layout_interaction_pressure": "布局交互",
    "information_structure_pressure": "信息结构",
    "task_flow_change": "流程承接",
    "business_rule_change": "业务规则",
    "review_risk": "评审风险",
    "business_capability_change": "业务能力"
  },
  "fallback_pressure_fields": ["layout_interaction_pressure", "copy_comprehension_pressure"],
  "default_design_pressure": "布局交互",
  "max_design_pressure_count": 5,
  "experience_focus_by_pressure": {
    "信息结构": "重点展开模块定义、信息分组、入口归属和页面层级。",
    "权限治理": "重点展开可操作条件、不可操作原因、风险提示和异常后的下一步。",
    "状态异常": "重点展开状态含义、异常触发、反馈形式、失败原因和补救路径。",
    "文案理解": "重点展开用户可见文案、解释位置、下一步提示和术语命名。",
    "布局交互": "重点展开默认状态、交互边界、极限状态、响应方式和偏好记忆。",
    "流程承接": "重点展开主路径变化、步骤衔接、角色协同和结果回写。",
    "业务规则": "重点展开规则边界、校验条件、限制原因和体验承接要求。",
    "评审风险": "重点展开容易误解的边界、争议点和必须确认项。",
    "业务能力": "重点展开能力变化、方案形态和与现有能力的关系。"
  },
  "guardrail_review_fields": {
    "permission_governance_risk": {
      "levels": ["medium", "major", "high"],
      "message": "当前需求可能涉及权限、数据范围、审批或治理边界，不应被直接当作纯局部体验优化。"
    },
    "business_rule_change": {
      "levels": ["medium", "major", "high"],
      "message": "当前需求可能改变业务规则、限制或校验，建议先确认规则边界。"
    },
    "state_exception_pressure": {
      "levels": ["medium", "major", "high"],
      "message": "当前需求可能改变状态、异常或阻断逻辑，建议先确认状态含义和失败处理。"
    },
    "information_structure_pressure": {
      "levels": ["high"],
      "message": "当前需求可能不是单纯文案问题，而是概念、模块或入口归属问题。"
    },
    "review_risk": {
      "levels": ["medium", "major", "high"],
      "message": "当前需求存在明显待确认边界，UXB 需要先和用户确认关键问题。"
    }
  }
}
