{
  "version": "route-decision-rules@1.0",
  "demand_types": [
    "局部体验优化",
    "布局交互优化",
    "文案与信息表达优化",
    "信息结构与概念澄清",
    "既有能力扩展",
    "业务流程调整",
    "权限与治理风险",
    "功能新增",
    "功能重构",
    "不确定"
  ],
  "default_demand_type": "不确定",
  "evidence_terms": ["目标", "需要", "支持", "新增", "优化", "调整", "重构", "权限", "状态", "文案", "布局"],
  "fallback_evidence": "未读取到足够明确的需求正文，建议补充 source 输入。",
  "negation_markers": ["不涉及", "不改变", "不新增", "不影响", "不要求", "不在本需求", "无需", "沿用现有", "只影响", "只补充", "只保留"],
  "signal_rules": [
    {
      "demand_type": "功能重构",
      "terms": ["重构", "改造", "重新设计", "模型调整", "关系重构", "链路重构", "状态机"],
      "evidence_label": "出现功能或模型重构信号",
      "route_pressure": 4
    },
    {
      "demand_type": "功能新增",
      "terms": ["新增功能", "新增能力", "新建模块", "增加入口", "新增页面", "新增模式", "自助申请", "自动授予"],
      "evidence_label": "出现新增核心能力信号",
      "route_pressure": 3
    },
    {
      "demand_type": "权限与治理风险",
      "terms": ["权限模型", "权限规则", "权限范围", "权限边界", "授权", "审批治理", "审批范围", "审批模式", "审计", "治理", "敏感", "数据范围", "可见范围"],
      "evidence_label": "涉及权限、审批、数据范围或治理",
      "route_pressure": 4
    },
    {
      "demand_type": "业务流程调整",
      "terms": ["流程", "闭环", "提交", "撤回", "生效", "回写", "协同", "多角色"],
      "evidence_label": "涉及流程、结果回写或角色协同",
      "route_pressure": 3
    },
    {
      "demand_type": "既有能力扩展",
      "terms": ["增加", "扩展", "导出", "批量", "配置项", "明细"],
      "evidence_label": "在既有能力上增加规则或能力",
      "route_pressure": 2
    },
    {
      "demand_type": "信息结构与概念澄清",
      "terms": ["概念", "归属", "入口", "信息结构", "模块边界", "对象关系"],
      "evidence_label": "需要澄清概念、入口或信息结构",
      "route_pressure": 2
    },
    {
      "demand_type": "文案与信息表达优化",
      "terms": ["文案", "提示语", "说明", "命名", "tooltip", "空状态", "解释"],
      "evidence_label": "主要关注文案或信息表达",
      "route_pressure": 1
    },
    {
      "demand_type": "布局交互优化",
      "terms": ["布局", "拖动", "宽度", "展示密度", "默认展开", "响应", "区域", "按钮态"],
      "evidence_label": "主要关注布局或局部交互",
      "route_pressure": 1
    },
    {
      "demand_type": "局部体验优化",
      "terms": ["体验优化", "微调", "小改", "局部", "可见性", "状态提示", "禁用按钮"],
      "evidence_label": "主要关注局部体验表达",
      "route_pressure": 1
    }
  ],
  "dimension_fields": [
    "business_capability_change",
    "business_rule_change",
    "permission_governance_risk",
    "task_flow_change",
    "information_structure_pressure",
    "state_exception_pressure",
    "copy_comprehension_pressure",
    "layout_interaction_pressure",
    "review_risk"
  ],
  "dimension_rules": {
    "business_capability_change": {
      "terms": ["新增能力", "新增功能", "新建模块", "重构", "扩展"],
      "hit_reason": "业务能力发生变化或扩展",
      "miss_reason": "需求未表现出新增或重构能力，主要是既有能力内调整",
      "miss_level": "none",
      "default_hit_level": "minor",
      "value_triggers": [
        {"terms": ["重构", "新增能力", "新增功能"], "level": "major"}
      ]
    },
    "business_rule_change": {
      "terms": ["规则", "校验", "限制", "配置项", "范围", "必须", "允许", "禁止"],
      "hit_reason": "存在业务规则、校验或条件变化",
      "miss_reason": "未发现明确业务规则变化信号",
      "miss_level": "none",
      "default_hit_level": "medium",
      "value_triggers": [
        {"terms": ["多角色"], "level": "major"}
      ]
    },
    "permission_governance_risk": {
      "terms": ["权限模型", "权限规则", "权限范围", "权限边界", "授权", "审批治理", "审批范围", "审批模式", "审计", "治理", "数据范围", "敏感", "可见范围", "超出当前权限", "缺少权限"],
      "hit_reason": "涉及权限、审批、数据范围、导出或治理风险",
      "miss_reason": "未发现权限、审批、数据范围或治理变化",
      "miss_level": "none",
      "default_hit_level": "high",
      "value_triggers": [
        {"terms": ["权限模型", "审批模式", "数据范围"], "level": "high"}
      ]
    },
    "task_flow_change": {
      "terms": ["流程", "步骤", "提交", "撤回", "生效", "回写", "协同", "多角色"],
      "hit_reason": "用户任务路径、结果回写或角色协同可能变化",
      "miss_reason": "未发现主任务路径变化",
      "miss_level": "none",
      "default_hit_level": "medium",
      "value_triggers": [
        {"terms": ["多角色"], "level": "major"}
      ]
    },
    "information_structure_pressure": {
      "terms": ["概念", "定义", "归属", "入口", "层级", "模块", "关系", "分组", "信息结构"],
      "hit_reason": "存在概念、入口、层级或模块边界压力",
      "miss_reason": "未发现明显信息结构或概念澄清压力",
      "miss_level": "none",
      "default_hit_level": "medium",
      "value_triggers": [
        {"terms": ["重构"], "level": "high"}
      ]
    },
    "state_exception_pressure": {
      "terms": ["状态机", "状态变化", "审批状态", "状态筛选", "暂缓状态", "异常", "失败", "部分成功", "阻断", "不可操作", "校验", "生效", "失效"],
      "hit_reason": "状态、异常、阻断或校验会影响方案",
      "miss_reason": "未发现明显状态、异常或校验压力",
      "miss_level": "none",
      "default_hit_level": "medium",
      "value_triggers": [
        {"terms": ["状态机", "阻断"], "level": "high"}
      ]
    },
    "copy_comprehension_pressure": {
      "terms": ["文案", "提示", "说明", "解释", "tooltip", "空状态", "命名", "看不懂"],
      "hit_reason": "用户理解主要依赖文案、说明或提示",
      "miss_reason": "未发现文案理解是主要压力",
      "miss_level": "low",
      "default_hit_level": "low",
      "value_triggers": []
    },
    "layout_interaction_pressure": {
      "terms": ["布局", "拖动", "宽度", "展示", "密度", "默认", "响应", "按钮", "区域"],
      "hit_reason": "局部布局、展示或交互细节是明显压力",
      "miss_reason": "未发现布局交互是主要压力",
      "miss_level": "low",
      "default_hit_level": "low",
      "value_triggers": []
    },
    "review_risk": {
      "terms": ["不清", "边界", "争议", "误解", "确认", "风险", "不确定", "可能"],
      "hit_reason": "存在评审误解、边界争议或待确认风险",
      "miss_reason": "当前信息未暴露明显评审风险",
      "miss_level": "low",
      "default_hit_level": "medium",
      "value_triggers": []
    }
  },
  "route_policy": {
    "full_demand_types": ["功能重构", "功能新增"],
    "full_dimension_values": [
      {"field": "business_capability_change", "levels": ["major"]}
    ],
    "full_when_state_exception_high_with_demand_types": {
      "field": "state_exception_pressure",
      "levels": ["high"],
      "demand_types": ["功能新增", "功能重构"]
    },
    "standard_demand_types": ["权限与治理风险", "既有能力扩展", "业务流程调整", "信息结构与概念澄清"],
    "standard_dimension_values": {
      "fields": ["business_rule_change", "task_flow_change", "state_exception_pressure", "permission_governance_risk"],
      "levels": ["medium", "major", "high"]
    },
    "standard_when_route_pressure_at_least": 2,
    "default_route": "fast"
  },
  "confidence_policy": {
    "no_signal": "low",
    "default": "medium",
    "high_non_none_dimension_count": 4,
    "fast_with_risk": {
      "fields": ["permission_governance_risk", "business_rule_change", "state_exception_pressure"],
      "levels": ["medium", "major", "high"],
      "confidence": "medium"
    }
  },
  "pressure_labels": {
    "permission_governance_risk": "权限治理",
    "state_exception_pressure": "状态异常",
    "copy_comprehension_pressure": "文案理解",
    "layout_interaction_pressure": "布局交互",
    "information_structure_pressure": "信息结构",
    "task_flow_change": "流程承接",
    "business_rule_change": "业务规则",
    "review_risk": "评审风险",
    "business_capability_change": "业务能力"
  },
  "fallback_pressure_fields": ["layout_interaction_pressure", "copy_comprehension_pressure"],
  "default_design_pressure": "布局交互",
  "max_design_pressure_count": 5,
  "business_depth_by_route": {
    "fast": "note",
    "standard": "lite",
    "full": "full"
  },
  "experience_focus_by_pressure": {
    "信息结构": "重点展开模块定义、信息分组、入口归属和页面层级",
    "权限治理": "重点展开可操作条件、不可操作原因、风险提示和异常后的下一步",
    "状态异常": "重点展开状态含义、异常触发、反馈形式、失败原因和补救路径",
    "文案理解": "重点展开用户可见文案、解释位置、下一步提示和术语命名",
    "布局交互": "重点展开默认状态、交互边界、极限状态、响应方式和偏好记忆",
    "流程承接": "重点展开主路径变化、步骤衔接、角色协同和结果回写",
    "业务规则": "重点展开规则边界、校验条件、限制原因和体验承接要求",
    "评审风险": "重点展开容易误解的边界、争议点和必须确认项",
    "业务能力": "重点展开能力变化、方案形态和与既有能力的关系"
  },
  "non_focus_guidance_by_route": {
    "fast": ["业务章节只保留必要依据，明确不影响权限、审批、数据范围、状态机和业务对象关系。"],
    "standard": ["非重点章节只写结论和必要边界，不补泛化价值分析、泛化风险或无依据收益估算。"],
    "full": ["保持完整业务和体验蓝图，但仍按主要设计压力分配篇幅，避免平均铺开。"]
  },
  "escalation_signals_by_route": {
    "fast": [
      "后续发现权限、审批、数据范围、导出或状态机变化时，需升级 standard。",
      "后续发现新增业务规则、校验条件或阻断异常决定方案成败时，需升级 standard。",
      "后续发现需求原文存在明显更优解或体验风险时，需重新判断路线。"
    ],
    "standard": [
      "后续发现新增核心业务能力、重构既有模块或改变业务对象关系时，需升级 full。",
      "后续发现多角色协作闭环、权限模型、审批模式或状态机变化时，需升级 full。",
      "后续 facts/business 出现关键 GAP，无法支撑体验方案时，需升级 full 或暂停确认。"
    ],
    "full": [
      "当前已建议 full，不建议自动降级。",
      "如果后续事实证明范围更小，也应由人工确认后再调整，不自动改为 fast 或 standard。"
    ]
  },
  "reason_templates": {
    "fast": "初判为{demand_type}，主要压力在{pressure}，未发现会改变核心业务规则的信号。",
    "standard": "初判为{demand_type}，主要压力在{pressure}，需要保留业务边界判断后再转体验方案。",
    "full": "初判为{demand_type}，主要压力在{pressure}，涉及核心能力、治理或模型边界，需走完整链路。"
  }
}
