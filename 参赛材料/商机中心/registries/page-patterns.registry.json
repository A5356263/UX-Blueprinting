{
  "kind": "ux-proto-pattern-registry",
  "records": [
    {
      "id": "pattern.shared.business-document-form",
      "kind": "pattern",
      "lifecycle": "active",
      "pattern": {
        "defaultOrder": [
          "document-context",
          "section-navigation",
          "semantic-form-groups",
          "detail-lines",
          "decision-actions"
        ],
        "forbiddenCombinations": [
          "Materialize both single-page and wizard Templates into the same form"
        ],
        "optionalRegions": [
          {
            "id": "detail-lines",
            "responsibility": "Edit repeatable business line items when the document requires them."
          },
          {
            "id": "section-navigation",
            "responsibility": "Navigate a long continuous form without turning it into false stages."
          }
        ],
        "pageOwns": [
          "business fields",
          "form state",
          "validation",
          "draft and submit handlers",
          "business copy"
        ],
        "referenceRefs": [],
        "requiredRegions": [
          {
            "id": "document-context",
            "responsibility": "Identify the document, mode, and consequential state."
          },
          {
            "id": "semantic-form-groups",
            "responsibility": "Collect business information in understandable groups or stages."
          },
          {
            "id": "decision-actions",
            "responsibility": "Expose recovery and the action that completes the current intent."
          }
        ],
        "styleUses": [
          "main-container-bright"
        ],
        "task": "Create or edit one business document and commit the intended change."
      },
      "relations": [
        {
          "target": "knowledge.shared.form-presentation-mode",
          "type": "requires"
        },
        {
          "target": "knowledge.shared.action-emphasis-by-intent",
          "type": "requires"
        }
      ],
      "resolvedRelations": {
        "incoming": [
          {
            "source": "template.xft.single-page-business-form",
            "type": "recommended-for"
          },
          {
            "source": "template.xft.wizard-business-form",
            "type": "recommended-for"
          }
        ],
        "outgoing": [
          {
            "target": "knowledge.shared.form-presentation-mode",
            "type": "requires"
          },
          {
            "target": "knowledge.shared.action-emphasis-by-intent",
            "type": "requires"
          }
        ]
      },
      "schemaVersion": 3,
      "selection": {
        "avoidWhen": [
          "read-only detail or list management"
        ],
        "useWhen": [
          "creating or editing one business document"
        ]
      },
      "summary": "Create or edit one business document with meaningful grouping, recovery, validation, and a clear completion action.",
      "title": "Business Document Form"
    },
    {
