          {
            "target": "knowledge.shared.bulk-vs-row-actions",
            "type": "requires"
          },
          {
            "target": "knowledge.shared.action-emphasis-by-intent",
            "type": "requires"
          },
          {
            "target": "pattern.shared.search-filter-configuration",
            "type": "supports"
